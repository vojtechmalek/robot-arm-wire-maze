    </inertial>
    <!-- Approximate a thin hoop (cylinder with hole) using 16 thin boxes around the edge -->
    <!-- Parameters: radius ~ midpoint between 0.06 and 0.055, box size: radial x, tangential y, height z -->
    <!-- <material name="hoop_mat">
      <color rgba="1.0 0.84 0.0 1.0" />
    </material> -->

    

    <visual>
      <origin xyz="0 0 0.003" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0348" length="0.006" />
      </geometry>
      <material name="hoop_mat">
        <color rgba="1.0 0.84 0.0 1.0" />
      </material>
    </visual>

    <!-- 16 segments -->
    <!-- 1 -->
    <visual>
      <origin xyz="0.0324 0 0.003" rpy="0 0 0" />
      <geometry><box size="0.010 0.018 0.012" /></geometry>
      <material name="hoop_mat"/>
    </visual>
    <collision>
